{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Upgrades the `engines.node` field in the `package.json` file from the `node` Docker image tags, so the bump only appears once the Alpine image exists",
  "packageRules": [
    {
      "description": "Replaced by the custom manager below",
      "enabled": false,
      "matchDepNames": ["node"],
      "matchDepTypes": ["engines"],
      "matchManagers": ["npm"]
    },
    {
      "description": "`docker:pinDigests` matches on datasource; `package.json` cannot hold a digest",
      "commitMessageTopic": "Node.js",
      "groupSlug": "node",
      "groupName": "Node.js",
      "matchDepNames": ["node"],
      "matchManagers": ["custom.regex"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "depNameTemplate": "node",
      "depTypeTemplate": "engines",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)-alpine\\d+\\.\\d+$",
      "managerFilePatterns": ["/(^|/)package\\.json$/"],
      "matchStrings": ["\"node\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "versioningTemplate": "node"
    }
  ]
}
